{
  "name": "color-status-labeler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:site": "vite --config site/vite.config.ts",
    "build:extension": "wxt build && wxt zip",
    "build:site:static": "vite build --config site/vite.config.ts",
    "build:site": "node scripts/build.mjs",
    "build": "npm run build:site",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "verify:deployment": "node scripts/verify-live-deployment.mjs",
    "verify:browser": "node scripts/verify-live-browser.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@types/chrome": "0.0.287",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "playwright-core": "1.58.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.68.0",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "wxt": "0.21.4"
  }
}
